<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Backup rules.
      The transfer history is not worth restoring (it describes files that are on a previous device),
      but the settings are, so only the settings file is included.
    -->
    <full-backup-content>
        <include domain="sharedpref" path="quickshare_settings.xml" />
        <exclude domain="sharedpref" path="quickshare_history.xml" />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </full-backup-content>
</resources>
