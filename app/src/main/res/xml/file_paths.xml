<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
      The FileProvider exposes exactly one directory: the staging area inside app-private storage
      where a received file is written before it is copied into the user's chosen SAF folder. Keeping
      the exposed surface to a single directory means no other app-private path is reachable.
    -->
    <files-path name="staging" path="staging/" />
    <cache-path name="cache" path="." />
</paths>
