# Copy to `keystore.properties` in the repo root and fill in your own values.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore quickshare-release.jks -alias quickshare \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass <storePassword> -keypass <keyPassword> \
#     -dname "CN=QuickShare, O=QuickShare, C=US"
#
# If this file is missing, `./gradlew assembleRelease` still succeeds: it falls back
# to the debug signing config so the APK stays installable for local testing.

storeFile=quickshare-release.jks
storePassword=changeit
keyAlias=quickshare
keyPassword=changeit
